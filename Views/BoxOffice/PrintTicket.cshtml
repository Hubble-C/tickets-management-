@{
    ViewData["Title"] = "Print Ticket";
    Layout = null; // Vista de impresión térmica limpia, sin JavaScript
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ticket – Theater POS</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Courier New', monospace; background: #fff; color: #111; width: 80mm; margin: 0 auto; padding: 8px; }
        .logo { text-align: center; margin-bottom: 8px; }
        .logo h1 { font-size: 18px; font-weight: bold; letter-spacing: 2px; }
        .logo p  { font-size: 10px; color: #555; }
        .divider { border-top: 1px dashed #999; margin: 8px 0; }
        .row { display: flex; justify-content: space-between; font-size: 11px; margin: 3px 0; }
        .row.big { font-size: 14px; font-weight: bold; margin: 6px 0; }
        .center { text-align: center; }
        .qr-placeholder { width: 120px; height: 120px; border: 2px solid #333; margin: 10px auto; display: flex; align-items: center; justify-content: center; font-size: 9px; color: #999; }
        .order { font-size: 13px; font-weight: bold; letter-spacing: 1px; }
        .footer { font-size: 9px; color: #777; text-align: center; margin-top: 10px; }
        @@media print { body { width: 100%; } .print-btn { display: none; } }
    </style>
</head>
<body>
    <article>
        <header class="logo">
            <h1>THEATER POS</h1>
            <p>tickets.andromeda.andrescortes.dev</p>
        </header>
 
        <div class="divider"></div>
 
        <section>
            <p class="center order">Order #@ViewData["OrderNumber"]</p>
        </section>
 
        <div class="divider"></div>
 
        <section id="ticketDetails">
            <div class="row big"><span>@ViewData["ShowName"]</span></div>
            <div class="row"><span>Date/Time</span><span>@ViewData["ShowTime"]</span></div>
            <div class="row"><span>Hall</span><span>@ViewData["Hall"]</span></div>
            <div class="row"><span>Seats</span><span>@ViewData["Seats"]</span></div>
            <div class="row"><span>Customer</span><span>@ViewData["Email"]</span></div>
            <div class="row"><span>Payment</span><span>@ViewData["PaymentMethod"]</span></div>
        </section>
 
        <div class="divider"></div>
 
        <section>
            <div class="row"><span>Subtotal</span><span>$@ViewData["Subtotal"]</span></div>
            <div class="row"><span>Service Fee</span><span>$@ViewData["ServiceFee"]</span></div>
            <div class="row big"><span>TOTAL</span><span>$@ViewData["Total"]</span></div>
        </section>
 
        <div class="divider"></div>
 
        <div class="qr-placeholder" aria-label="Digital Ticket QR Code">DIGITAL QR</div>
 
        <footer class="footer">
            <p>Thank you for your visit.</p>
            <p>This ticket is your proof of entry.</p>
            <p>Please preserve this document.</p>
        </footer>
    </article>
 
    <div style="text-align:center;margin-top:12px" class="print-btn">
        <button onclick="window.print()" style="padding:8px 20px;background:#0891b2;color:#fff;border:none;border-radius:6px;font-size:13px;font-weight:bold;cursor:pointer">
            🖨 Print Ticket
        </button>
    </div>
</body>
</html>
