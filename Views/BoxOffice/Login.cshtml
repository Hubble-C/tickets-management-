@{
    ViewData["Title"] = "Employee Login";
    Layout = "_Layout";
}

<main class="min-h-screen flex items-center justify-center p-4 bg-slate-50 dark:bg-slate-900 transition-colors duration-300">
    <article class="w-full max-w-md bg-white dark:bg-slate-800 rounded-3xl p-6 sm:p-8 shadow-xl border border-slate-100 dark:border-slate-700">
        
        <!-- Encabezado -->
        <header class="text-center mb-8">
            <div class="w-16 h-16 bg-cyan-600 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg shadow-cyan-600/20">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" role="img">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Employee Sign In</h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">tickets.andromeda.andrescortes.dev</p>
        </header>

        <!-- Formulario de Ingreso -->
        <form asp-action="Login" method="post" id="loginForm" class="space-y-5">
            @Html.AntiForgeryToken()

            <div>
                <label for="employeeId" class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-2">Employee ID</label>
                <input type="text" id="employeeId" name="employeeId" required autocomplete="username"
                       class="w-full h-14 px-4 text-base bg-slate-50 dark:bg-slate-700 border-2 border-slate-200 dark:border-slate-600 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 focus:border-cyan-600 focus:ring-0 outline-none transition-colors"
                       placeholder="e.g. EMP01">
            </div>

            <div>
                <label for="pinDisplay" class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-2">PIN Code</label>
                <input type="password" id="pinDisplay" name="pin" required autocomplete="current-password"
                       class="w-full h-14 px-4 text-center text-2xl tracking-widest bg-slate-50 dark:bg-slate-700 border-2 border-slate-200 dark:border-slate-600 rounded-xl text-slate-900 dark:text-white focus:border-cyan-600 focus:ring-0 outline-none transition-colors"
                       placeholder="••••">
            </div>

            <!-- Teclado Numérico Táctil Simulado -->
            <div class="grid grid-cols-3 gap-3 pt-2" role="region" aria-label="Keyboard Dial">
                @for (int i = 1; i <= 9; i++)
                {
                    var num = i.ToString();
                    <button type="button"
                            class="btn-touch h-14 text-xl font-bold bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-800 dark:text-white rounded-xl transition-all">
                        @num
                    </button>
                }
                <button type="button"
                        class="btn-touch h-14 text-sm font-bold bg-red-50 dark:bg-red-900/20 hover:bg-red-100 dark:hover:bg-red-900/30 text-red-600 dark:text-red-400 rounded-xl transition-all">
                    CLEAR
                </button>
                <button type="button"
                        class="btn-touch h-14 text-xl font-bold bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-800 dark:text-white rounded-xl transition-all">
                    0
                </button>
                <button type="submit"
                        class="btn-touch h-14 text-sm font-bold bg-cyan-600 hover:bg-cyan-700 text-white rounded-xl transition-all flex items-center justify-center">
                    ENTER
                </button>
            </div>
        </form>
    </article>
</main>
