@model OrderConfirmationViewModel
@{
    ViewData["Title"] = $"Order #{Model.Order.Id}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Order #@Model.Order.Id</h1>
    <span class="badge @StatusBadge(Model.Order.Status) fs-6">@Model.Order.Status</span>
</div>

<dl class="row">
    <dt class="col-sm-3">Customer</dt>
    <dd class="col-sm-9">@Model.Order.CustomerId <span class="text-muted">(NIT @Model.Order.Nit)</span></dd>
    <dt class="col-sm-3">Payment method</dt>
    <dd class="col-sm-9">@Model.Order.PaymentMethod</dd>
    <dt class="col-sm-3">Total</dt>
    <dd class="col-sm-9">@Model.Total.ToString("C")</dd>
</dl>

<div class="mb-4">
    <form class="d-inline" asp-action="Pay" asp-route-id="@Model.Order.Id" method="post" data-disable-on-submit>
        <button class="btn btn-success btn-sm" type="submit" disabled="@(Model.Order.Status != OrderStatus.Pending)">
            Mark as paid
        </button>
        
    </form>
    
    <form class="d-inline" asp-action="Pay" asp-route-id="@Model.Order.Id" method="post" data-disable-on-submit>
        <button class="btn btn-success btn-sm" type="submit" disabled="@(Model.Order.Status != OrderStatus.Pending)">
            Mark as paid
        </button>
        <a class="btn btn-outline-primary btn-sm"
           asp-action="Print" asp-route-id="@Model.Order.Id" target="_blank">
            Imprimir tickets
        </a>    
    </form>
    
    <form class="d-inline" asp-action="Cancel" asp-route-id="@Model.Order.Id" method="post" data-disable-on-submit>
        <button class="btn btn-outline-danger btn-sm" type="submit"
                disabled="@(Model.Order.Status is not (OrderStatus.Pending or OrderStatus.Paid))">
            Cancel order
        </button>
    </form>
</div>

<div class="row row-cols-1 row-cols-md-3 g-3">
    @foreach (var item in Model.Tickets)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body text-center">
                    <div class="qr mb-2">@Html.Raw(item.QrSvg)</div>
                    <h2 class="h6 mb-1">Seat @item.Ticket.Seat</h2>
                    <code>@item.Ticket.TicketCode</code>
                    <div><span class="badge bg-secondary mt-2">@item.Ticket.Status</span></div>
                </div>
            </div>
        </div>
    }
</div>

@functions {
    static string StatusBadge(OrderStatus status) => status switch
    {
        OrderStatus.Paid => "bg-success",
        OrderStatus.Cancelled => "bg-danger",
        OrderStatus.Rejected => "bg-warning text-dark",
        _ => "bg-secondary",
    };
}
