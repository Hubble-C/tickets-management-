@{
    ViewData["Title"] = "Home";
}

<div class="text-center mb-4">
    <h1 class="display-5">Tickets Management</h1>
    <p class="lead text-muted">Box office, ticketing and door validation.</p>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3">
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5 card-title">Box office</h2>
                <p class="card-text text-muted flex-grow-1">Sell tickets and generate their QR codes.</p>
                <a class="btn btn-primary" asp-controller="BoxOffice" asp-action="Checkout">New sale</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5 card-title">Door validation</h2>
                <p class="card-text text-muted flex-grow-1">Scan a code and admit the holder if the order is paid.</p>
                <a class="btn btn-primary" asp-controller="BoxOffice" asp-action="Validate">Validate</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5 card-title">Sales report</h2>
                <p class="card-text text-muted flex-grow-1">Revenue, tickets sold and a per-event breakdown.</p>
                <a class="btn btn-primary" asp-controller="BoxOffice" asp-action="Sales">View report</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5 card-title">My tickets</h2>
                <p class="card-text text-muted flex-grow-1">Browse the QR history for a customer.</p>
                <a class="btn btn-primary" asp-controller="Tickets" asp-action="History">Open history</a>
            </div>
        </div>
    </div>
</div>
