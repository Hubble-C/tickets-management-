@model CustomerHistoryViewModel
@{
    ViewData["Title"] = "My tickets";
}

<h1 class="h3 mb-3">My tickets</h1>

<form asp-action="History" method="get" class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label for="customerId" class="form-label">Customer Id</label>
        <input type="number" min="1" id="customerId" name="customerId" value="@Model.CustomerId" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Show tickets</button>
    </div>
</form>

@if (Model.Searched)
{
    @if (Model.Tickets.Count == 0)
    {
        <p class="text-muted">No tickets found for customer #@Model.CustomerId.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-4 g-3">
            @foreach (var item in Model.Tickets)
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body text-center">
                            <div class="qr mb-2">@Html.Raw(item.QrSvg)</div>
                            <h2 class="h6 mb-1">Seat @item.Ticket.Seat</h2>
                            <code class="small">@item.Ticket.TicketCode</code>
                            <div><span class="badge bg-secondary mt-2">@item.Ticket.Status</span></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
