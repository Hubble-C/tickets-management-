<script>
    // Simplified interactivity for demonstration
    document.querySelectorAll('.seat-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            if (this.classList.contains('bg-primary')) {
                // Deselect logic
                this.classList.remove('bg-primary', 'text-on-primary', 'ring-2', 'ring-primary', 'scale-110');
                if (this.innerText < 10) { 
                   // could restore original classes based on row
                }
            } else {
                // Select logic
                this.classList.add('bg-primary', 'text-on-primary', 'ring-2', 'ring-primary', 'scale-110');
            }
        });
    });

    function toggleSidebar() {
        const sidebar = document.getElementById('main-sidebar');
        const overlay = document.getElementById('sidebar-overlay');
        if (sidebar.classList.contains('-translate-x-full')) {
            sidebar.classList.remove('-translate-x-full');
            overlay.classList.remove('hidden');
        } else {
            sidebar.classList.add('-translate-x-full');
            overlay.classList.add('hidden');
        }
    }
</script>