
<div class="fixed inset-0 z-0 theater-bg overflow-hidden" 
     data-alt="A grand cinema auditorium viewed from the back of the room, showing rows of premium red velvet seats leading toward a large, dark silver screen. The lighting is cinematic and moody, with soft overhead spotlights casting long shadows and a teal-tinted atmospheric haze. The overall visual style is sophisticated and professional, aligning with a high-end corporate theater management environment." 
     style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBqoI3Tg_hsGcn1FhBTZdWULpln6ymNNb722ELu1yy1kW1cNIiVDgVMWFEB3qAfgCvwJB0gbSoxJCSWcjZWzKZoeKXl9q_9OpERnel1aqSF2Jbs9-vaBSGaAWFImKQAQzslV2FQwVmnYWUy0vsa21DxeyVbhBAgRo4XmjWWkYykET-KejjtW0naP65O9LWHzT65yu-whufchaNJ5pDUUStUYGrI-EsUAmazAn2t0ROx_wyZWyM_VF_VeyT4t6bQdUFoqZU9jlliREMr'); background-size: cover; background-position: center; background-repeat: no-repeat;">
    <div class="absolute inset-0 bg-inverse-surface/60 backdrop-blur-sm"></div>
</div>


<div class="relative z-10 min-h-screen w-full flex flex-col items-center justify-center p-4">

    <main class="w-full max-w-md px-edge_margin">
        
        <!-- Top Branding -->
        <div class="mb-xl text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-primary rounded-xl mb-md shadow-lg">
                <span class="material-symbols-outlined text-on-primary text-4xl" style="font-variation-settings: 'FILL' 1;">
                    confirmation_number
                </span>
            </div>
            <h1 class="font-headline-lg text-headline-lg text-white mb-xs">TheaterPos</h1>
            <p class="font-body-md text-body-md text-surface-variant/80">Terminal Principal • Secure Employee Login</p>
        </div>

        <!-- Login Card -->
        <div class="login-card p-xl rounded-xl shadow-2xl border border-outline-variant/30 bg-surface">
            <form class="space-y-lg" id="loginForm" asp-action="Login" method="post">
                
                <!-- Username Field -->
                <div class="space-y-xs">
                    <label class="font-label-caps text-label-caps text-on-surface-variant uppercase" for="username">
                        Username
                    </label>
                    <div class="relative group">
                        <span class="absolute left-md top-1/2 -translate-y-1/2 material-symbols-outlined text-on-surface-variant group-focus-within:text-primary transition-colors">
                            person
                        </span>
                        <input class="w-full pl-xl pr-md py-sm bg-surface-container-low border border-outline-variant rounded-lg font-body-md text-body-md input-focus-ring transition-all placeholder:text-on-surface-variant/40" 
                               id="username" 
                               name="username" 
                               placeholder="e.g. EMP01" 
                               required="" 
                               type="text" />
                    </div>
                </div>


                <div class="space-y-xs">
                    <div class="flex justify-between items-center">
                        <label class="font-label-caps text-label-caps text-on-surface-variant uppercase" for="password">
                            Password
                        </label>
                        <a class="font-label-caps text-label-caps text-primary hover:underline transition-all" href="#">
                            Forgot?
                        </a>
                    </div>
                    <div class="relative group">
                        <span class="absolute left-md top-1/2 -translate-y-1/2 material-symbols-outlined text-on-surface-variant group-focus-within:text-primary transition-colors">
                            lock
                        </span>
                        <input class="w-full pl-xl pr-xl py-sm bg-surface-container-low border border-outline-variant rounded-lg font-body-md text-body-md input-focus-ring transition-all placeholder:text-on-surface-variant/40" 
                               id="password" 
                               name="password" 
                               placeholder="••••••••" 
                               required="" 
                               type="password" />
                        <button class="absolute right-md top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-primary transition-colors" 
                                onclick="togglePassword()" 
                                type="button">
                            <span class="material-symbols-outlined text-lg" id="eyeIcon">visibility</span>
                        </button>
                    </div>
                </div>


                <div class="flex items-center gap-sm cursor-pointer select-none">
                    <input class="w-4 h-4 rounded border-outline-variant text-primary focus:ring-primary" id="remember" type="checkbox" />
                    <label class="font-body-md text-body-md text-on-surface-variant" for="remember">
                        Remember this terminal
                    </label>
                </div>


                <button class="w-full bg-primary text-on-primary font-headline-md text-headline-md py-md rounded-lg shadow-md hover:bg-primary-container transition-all active:scale-[0.98] flex items-center justify-center gap-sm" 
                        type="submit">
                    <span>Sign In</span>
                    <span class="material-symbols-outlined">login</span>
                </button>
            </form>


            <div class="mt-xl pt-lg border-t border-outline-variant/30 flex items-center justify-between">
                <div class="flex items-center gap-xs">
                    <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                    <span class="font-label-caps text-[10px] text-on-surface-variant uppercase tracking-wider">
                        System Online
                    </span>
                </div>
                <div class="flex items-center gap-sm">
                    <span class="material-symbols-outlined text-on-surface-variant text-md">help</span>
                    <span class="font-label-caps text-[10px] text-on-surface-variant uppercase tracking-wider">
                        Support
                    </span>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <footer class="mt-lg text-center">
            <p class="font-label-caps text-label-caps text-surface-variant/60 uppercase">
                © 2024 CinePOS Integrated Systems. All Rights Reserved.
            </p>
        </footer>
    </main>
</div>


<script>
    function togglePassword() {
        const passwordInput = document.getElementById('password');
        const eyeIcon = document.getElementById('eyeIcon');
        
        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            eyeIcon.textContent = 'visibility_off';
        } else {
            passwordInput.type = 'password';
            eyeIcon.textContent = 'visibility';
        }
    }
</script>
