@using tickets_management.Enums
@model tickets_management.Models.ViewModels.OrderSumary


    <!-- SIDEBAR OVERLAY -->
    <div id="sidebar-overlay" onclick="toggleSidebar()" class="hidden fixed inset-0 bg-black/50 z-30 md:hidden transition-opacity"></div>

    <aside id="main-sidebar" class="transform -translate-x-full md:translate-x-0 h-screen w-64 fixed left-0 top-0 bg-surface-container-low border-r border-outline-variant flex flex-col py-xl z-40 transition-transform duration-300">
    <div class="px-lg mb-xl flex justify-between items-center">
        <div>
            <h1 class="font-headline-md text-headline-md font-bold text-primary">CinePOS</h1>
            <p class="text-on-surface-variant font-body-md text-sm opacity-70">Terminal 01 - Main Lobby</p>
        </div>
        <button onclick="toggleSidebar()" class="md:hidden text-on-surface-variant p-2 rounded-lg hover:bg-surface-container-high">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>
    
    <nav class="flex-1 space-y-xs">
        <div class="flex items-center gap-4 px-4 py-3 text-on-surface-variant hover:bg-surface-container-high transition-colors cursor-pointer rounded-lg">
            <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-high transition-colors group" asp-controller="BoxOffice" asp-action="Pos">
                <span class="material-symbols-outlined">receipt_long</span>
                <span class="text-sm">Events</span>
            </a>
        </div>
        <div class="flex items-center gap-4 px-4 py-3 text-on-surface-variant hover:bg-surface-container-high transition-colors cursor-pointer rounded-lg">
            <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-high transition-colors group" asp-controller="BoxOffice" asp-action="Orders">
                <span class="material-symbols-outlined">receipt_long</span>
                <span class="text-sm">Orders</span>
            </a>
        </div>
    </nav>
    
    <div class="mt-auto px-md">
        <a asp-action="Pos" asp-controller="BoxOffice">
            <button class="w-full bg-primary text-on-primary py-md rounded-lg font-bold flex items-center justify-center gap-sm hover:opacity-90 transition-all">
                <span class="material-symbols-outlined">add</span>
                New Transaction
            </button>
        </a>
        <div class="mt-lg pt-lg border-t border-outline-variant flex items-center gap-sm">
            <img alt="Cashier Portrait" class="w-10 h-10 rounded-full bg-surface-container-high" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC0XtId4L4OQXZZKvz5aj5ryVSFvzPFC2_xC-zmDbKE_qCL8qFYFa3IbJipCPzugdmlt8I86_u8ShGQOCIAeEUXWoVJf8CMd5QYBSKCAPAFsJw5kjM3lEgmmF2N6s3jz6gfuuJvmtwl4gYaHm7Uy1rBbTeQ9bjQYd9fn3DNwUoElv1gQwMmPTnfeai9koecgzG3jAuDugq-QiqDOWSqOYxwKbuYGyY3hupbKu8tN2ps4J_QOYeAExTiBQZAqa6AybwEJ765RKX3YvPE"/>
            <div>
                <p class="font-bold text-sm">Elena R.</p>
                <p class="text-xs text-on-surface-variant">Shift Manager</p>
            </div>
        </div>
    </div>
</aside>

<header class="fixed top-0 right-0 w-full md:w-[calc(100%-16rem)] h-16 bg-surface border-b border-outline-variant flex justify-between items-center px-4 md:px-lg z-10">
    <div class="flex items-center gap-2 md:gap-lg">
        <button onclick="toggleSidebar()" class="md:hidden p-1.5 text-on-surface-variant hover:bg-surface-container-high rounded-lg">
            <span class="material-symbols-outlined">menu</span>
        </button>
        <h2 class="hidden sm:block font-headline-md text-headline-md font-bold text-primary">Box Office Central</h2>
        <div class="relative w-full max-w-[200px] md:w-64">
            <span class="material-symbols-outlined absolute left-sm top-1/2 -translate-y-1/2 text-outline">search</span>
            <input class="w-full pl-xl pr-md py-xs bg-surface-container-lowest border border-outline-variant rounded-full text-sm focus:outline-none focus:border-primary" placeholder="Search..." type="text"/>
        </div>
    </div>
    
    <div class="flex items-center gap-2 md:gap-md">
        <button class="hidden md:flex items-center gap-xs px-md py-xs border border-outline-variant rounded-lg text-sm hover:bg-secondary-container/50 transition-colors">
            <span class="material-symbols-outlined text-sm">history</span>
            Shift Summary
        </button>
        <div class="flex gap-1 md:gap-sm">
            <span class="material-symbols-outlined p-xs hover:bg-secondary-container/50 rounded-full cursor-pointer">notifications</span>
            <span class="material-symbols-outlined p-xs hover:bg-secondary-container/50 rounded-full cursor-pointer hidden md:block">help_outline</span>
        </div>
    </div>
</header>

<main class="md:ml-64 mt-16 p-4 md:p-xl min-h-[calc(100vh-4rem)]">
    <form id="form-pos" method="post" asp-action="Checkout" asp-controller="BoxOffice" class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-xl max-w-7xl mx-auto">
        
        <div class="col-span-1 md:col-span-7 flex flex-col gap-lg">
            <div class="bg-surface-container-lowest p-4 md:p-xl rounded-xl border border-outline-variant shadow-sm h-full">
                <div class="flex flex-col sm:flex-row border-b border-outline-variant mb-xl">
                    <button type="button" class="px-4 sm:px-xl py-3 sm:py-md font-headline-md text-base sm:text-headline-md text-primary border-b-2 sm:border-b-2 border-primary transition-all duration-200" id="tab-new">
                        Register New User
                    </button>
                    <button type="button" class="px-4 sm:px-xl py-3 sm:py-md font-headline-md text-base sm:text-headline-md text-on-surface-variant hover:text-primary transition-all duration-200" id="tab-existing">
                        Existing Customer
                    </button>
                </div>
                
                <div id="form-new" class="space-y-lg">
                    <div class="grid grid-cols-1 gap-md">
                        <div class="flex flex-col gap-xs">
                            <label class="font-label-caps text-label-caps text-on-surface-variant uppercase">Full Name</label>
                            <input name="Name" class="p-md bg-surface border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all" placeholder="e.g. John Doe" type="text"/>
                        </div>
                    </div>
                    
                    <div class="flex flex-col gap-xs">
                        <label class="font-label-caps text-label-caps text-on-surface-variant uppercase">Email Address</label>
                        <input name="Email" class="p-md bg-surface border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all" placeholder="john.doe@email.com" type="email"/>
                    </div>
                    
                    <div class="flex flex-col gap-xs">
                        <label class="font-label-caps text-label-caps text-on-surface-variant uppercase">Phone (Optional)</label>
                        <input name="Phone" class="p-md bg-surface border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all" placeholder="+1 000 000 0000" type="tel"/>
                    </div>
                    
                    <div class="pt-md border-t border-outline-variant">
                        <div class="flex items-start gap-sm">
                            <input class="w-5 h-5 mt-1 rounded text-primary focus:ring-primary border-outline-variant" id="loyalty" type="checkbox"/>
                            <label class="font-body-md text-sm md:text-base text-on-surface-variant" for="loyalty">Enroll in loyalty program (CineRewards)</label>
                        </div>
                    </div>
                    
                    <div class="mt-xl relative rounded-xl overflow-hidden aspect-[16/6] bg-surface-container hidden md:block">
                        <img class="w-full h-full object-cover mix-blend-multiply opacity-20" data-alt="A wide angle cinematic shot of a modern movie theater interior..." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDxnJVrijy9_ugkXcwaleJoE6cGeCnoAU6IJNV9vqylbTs2T_MA59p1LI8hZXwXxl8OsMbOIAUiBNXn4mgOqJRnHIxtwC3BYG6j_WAIpO2zoUba7_WkqsU56WWJOIX04dSnQ4-qf0TMSCveD6caoYBsrUgLO_MpC7GNzGgnGPUStCphiHTAFMP8oIXpaqiHtonKTs7VPEyMQjO--TY8vCSOhpoFngj1A7UMSkCsAM5O4J1SyBoxEAo7xSrnswm1mlPSL8DKEI7NJHWZ"/>
                        <div class="absolute inset-0 flex flex-col justify-center px-xl">
                            <span class="font-headline-md text-headline-md text-primary font-bold">Capture Customer Joy</span>
                            <p class="font-body-md text-on-surface-variant max-w-sm mt-xs">Registering users allows for personalized offers and digital ticket delivery.</p>
                        </div>
                    </div>
                    
                </div>
                
                <div id="form-existing" class="hidden space-y-lg">
                    <div class="flex flex-col gap-xs">
                        <label class="font-label-caps text-label-caps text-on-surface-variant uppercase">Customer Email</label>
                        <input class="p-md bg-surface border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary outline-none" placeholder="email@example.com" type="email" name="ExistingEmail" />
                    </div>
                    <p class="text-sm text-on-surface-variant">Enter the registered email to find the customer's profile.</p>
                </div>
            </div>
        </div>
        
        <div class="col-span-1 md:col-span-5 flex flex-col gap-lg" id="contenedor-resumen">
            <partial name="_ResumenPedido" model="Model"/>
        </div>
    </form>
</main>

<script>
        function selectPayment(element) {
            // Remove active classes from all buttons
            document.querySelectorAll('.payment-btn').forEach(btn => {
                btn.classList.remove('border-2', 'border-primary', 'bg-secondary-container/20');
                btn.classList.add('border', 'border-outline-variant');
                btn.querySelector('span:first-child').classList.remove('text-primary');
                btn.querySelector('span:first-child').style.fontVariationSettings = "'FILL' 0";
                btn.querySelector('span:last-child').classList.remove('text-primary');
            });

            // Add active classes to selected button
            element.classList.remove('border', 'border-outline-variant');
            element.classList.add('border-2', 'border-primary', 'bg-secondary-container/20');
            element.querySelector('span:first-child').classList.add('text-primary');
            element.querySelector('span:first-child').style.fontVariationSettings = "'FILL' 1";
            element.querySelector('span:last-child').classList.add('text-primary');
        }

        const tabNew = document.getElementById('tab-new');
        const tabExisting = document.getElementById('tab-existing');
        const formNew = document.getElementById('form-new');
        const formExisting = document.getElementById('form-existing');

        tabExisting.addEventListener('click', () => {
            // Estilos de botones
            tabExisting.classList.add('text-primary', 'border-b-2', 'border-primary');
            tabExisting.classList.remove('text-on-surface-variant');
            tabNew.classList.remove('text-primary', 'border-b-2', 'border-primary');
            tabNew.classList.add('text-on-surface-variant');

            // Alternar formularios
            formNew.classList.add('hidden');
            formExisting.classList.remove('hidden');
        });

        tabNew.addEventListener('click', () => {
            tabNew.classList.add('text-primary', 'border-b-2', 'border-primary');
            tabNew.classList.remove('text-on-surface-variant');
            tabExisting.classList.remove('text-primary', 'border-b-2', 'border-primary');
            tabExisting.classList.add('text-on-surface-variant');

            formNew.classList.remove('hidden');
            formExisting.classList.add('hidden');
        });
        
        function toggleSidebar() {
            const sidebar = document.getElementById('main-sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            if (sidebar.classList.contains('-translate-x-full')) {
                sidebar.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
            } else {
                sidebar.classList.add('-translate-x-full');
                overlay.classList.add('hidden');
            }
        }
</script>
