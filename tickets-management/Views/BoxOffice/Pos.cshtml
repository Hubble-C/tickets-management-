    <script>
        // Render dinámico del mapa de asientos removiendo el document.write antiguo
        const rowsArr = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J'];
        const gridTarget = document.getElementById('dynamic-grid-placeholder');

        gridTarget.innerHTML = rowsArr.map(row => `
            <div class="flex items-center gap-4">
                <span class="w-6 text-right font-mono text-xs text-on-surface-variant/60">${row}</span>
                <div class="seat-grid">
                    ${Array(20).fill(0).map((_, i) => {
                        const isOccupied = Math.random() < 0.25;
                        const isVip = ['A', 'B', 'C'].includes(row);
                        const seatClass = isOccupied 
                            ? 'bg-outline-variant text-white cursor-not-allowed pointer-events-none' 
                            : isVip 
                                ? 'bg-surface-container text-tertiary border border-tertiary/20 hover:ring-2 hover:ring-tertiary/50' 
                                : 'bg-surface-container text-primary border border-primary/20 hover:ring-2 hover:ring-primary/50';
                        return `
                            <button class="seat-btn w-6 h-6 rounded-sm transition-all flex items-center justify-center font-mono text-[10px] ${seatClass}">
                                ${isOccupied ? 'X' : i + 1}
                            </button>
                        `;
                    }).join('')}
                </div>
                <span class="w-6 text-left font-mono text-xs text-on-surface-variant/60">${row}</span>
            </div>
        `).join('');

        // Manejo manual de la selección visual de sillas
        document.querySelectorAll('.seat-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                if (this.classList.contains('bg-primary')) {
                    this.classList.remove('bg-primary', 'text-white', 'ring-2', 'ring-primary', 'scale-110');
                } else {
                    this.classList.add('bg-primary', 'text-white', 'ring-2', 'ring-primary', 'scale-110');
                }
            });
        });

        // Alternancia de Vistas (Control UI mediante Clases)
        function showSeatsView(movieName) {
            document.getElementById('view-pos-catalog').classList.add('hidden');
            document.getElementById('view-seats-selection').classList.remove('hidden');
            
            // Actualiza los headers con el título del evento elegido
            document.getElementById('selected-movie-title').innerText = movieName;
            document.getElementById('summary-movie-title').innerText = movieName;

            // Sincroniza estilo activo en sidebar
            document.getElementById('nav-events').className = "flex items-center gap-4 px-4 py-3 bg-secondary-container text-on-secondary-container border-r-4 border-primary font-bold transition-all duration-150 cursor-pointer rounded-r-lg";
        }

        function showCatalogView() {
            document.getElementById('view-seats-selection').classList.add('hidden');
            document.getElementById('view-pos-catalog').classList.remove('hidden');
        }
    </script>