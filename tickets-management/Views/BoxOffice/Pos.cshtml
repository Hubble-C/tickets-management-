@{
    ViewData["Title"] = "POS – Theater Box Office";
    Layout = "_Layout";
}

<div class="min-h-screen">
  <header class="bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 px-4 py-3 sticky top-0 z-50">
    <div class="flex items-center justify-between max-w-7xl mx-auto">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-cyan-600 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
          </svg>
        </div>
        <div>
          <h1 class="text-lg font-bold text-slate-900 dark:text-white">Theater POS</h1>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Booth #1
          </p>
        </div>
      </div>
      <nav class="flex items-center gap-2">
        <span class="hidden sm:block text-sm text-slate-600 dark:text-slate-300 font-medium">Carlos Ramírez</span>
        <a href="@Url.Action("Logout","BoxOffice")"
           class="btn-touch h-10 px-4 flex items-center gap-2 bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 rounded-lg font-medium hover:bg-red-200 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
          </svg>
          <span class="hidden sm:inline">Logout</span>
        </a>
      </nav>
    </div>
  </header>

  <form asp-action="Checkout" method="post" class="max-w-7xl mx-auto p-4">
    @Html.AntiForgeryToken()
    <div class="grid lg:grid-cols-5 gap-4">

      <!-- Panel Izquierdo -->
      <section class="lg:col-span-3 space-y-4">

        <!-- Selección de Funciones (Tarjetas visuales) -->
        <article class="bg-white dark:bg-slate-800 rounded-2xl p-4 shadow-sm border border-slate-200 dark:border-slate-700">
          <h2 class="text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-3">Select Show</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            
            <label class="btn-touch flex items-start gap-3 p-4 border-2 border-slate-200 dark:border-slate-600 rounded-xl text-left hover:border-cyan-600 dark:hover:border-cyan-500 cursor-pointer transition-all has-[:checked]:border-cyan-600 has-[:checked]:bg-cyan-50 dark:has-[:checked]:bg-cyan-900/20">
              <input type="radio" name="ShowId" value="1" checked class="sr-only">
              <div class="w-12 h-12 bg-cyan-100 dark:bg-cyan-900/30 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-bold text-slate-900 dark:text-white truncate">The Phantom of the Opera</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">Monday, October 12 • 07:00 PM</p>
                <p class="text-sm font-semibold text-cyan-600 dark:text-cyan-400">$45.00</p>
              </div>
            </label>

            <label class="btn-touch flex items-start gap-3 p-4 border-2 border-slate-200 dark:border-slate-600 rounded-xl text-left hover:border-cyan-600 dark:hover:border-cyan-500 cursor-pointer transition-all has-[:checked]:border-cyan-600 has-[:checked]:bg-cyan-50 dark:has-[:checked]:bg-cyan-900/20">
              <input type="radio" name="ShowId" value="2" class="sr-only">
              <div class="w-12 h-12 bg-cyan-100 dark:bg-cyan-900/30 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-bold text-slate-900 dark:text-white truncate">Hamilton</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">Tuesday, October 13 • 08:30 PM</p>
                <p class="text-sm font-semibold text-cyan-600 dark:text-cyan-400">$65.00</p>
              </div>
            </label>

            <label class="btn-touch flex items-start gap-3 p-4 border-2 border-slate-200 dark:border-slate-600 rounded-xl text-left hover:border-cyan-600 dark:hover:border-cyan-500 cursor-pointer transition-all has-[:checked]:border-cyan-600 has-[:checked]:bg-cyan-50 dark:has-[:checked]:bg-cyan-900/20">
              <input type="radio" name="ShowId" value="3" class="sr-only">
              <div class="w-12 h-12 bg-cyan-100 dark:bg-cyan-900/30 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-bold text-slate-900 dark:text-white truncate">Les Misérables</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">Wednesday, October 14 • 02:00 PM</p>
                <p class="text-sm font-semibold text-cyan-600 dark:text-cyan-400">$55.00</p>
              </div>
            </label>

            <label class="btn-touch flex items-start gap-3 p-4 border-2 border-slate-200 dark:border-slate-600 rounded-xl text-left hover:border-cyan-600 dark:hover:border-cyan-500 cursor-pointer transition-all has-[:checked]:border-cyan-600 has-[:checked]:bg-cyan-50 dark:has-[:checked]:bg-cyan-900/20">
              <input type="radio" name="ShowId" value="4" class="sr-only">
              <div class="w-12 h-12 bg-cyan-100 dark:bg-cyan-900/30 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-bold text-slate-900 dark:text-white truncate">The Lion King</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">Thursday, October 15 • 07:00 PM</p>
                <p class="text-sm font-semibold text-cyan-600 dark:text-cyan-400">$50.00</p>
              </div>
            </label>

          </div>
        </article>

        <!-- Mapa de Asientos (Grilla visual de sillas) -->
        <article class="bg-white dark:bg-slate-800 rounded-2xl p-4 shadow-sm border border-slate-200 dark:border-slate-700">
          <header class="flex items-center justify-between mb-4">
            <h2 class="text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide">Select Seats</h2>
            <div class="flex items-center gap-4 text-xs" role="legend" aria-label="Seat legend">
              <span class="flex items-center gap-1">
                <span class="w-4 h-4 rounded bg-slate-200 dark:bg-slate-600"></span>
                <span class="text-slate-600 dark:text-slate-400">Available</span>
              </span>
              <span class="flex items-center gap-1">
                <span class="w-4 h-4 rounded bg-cyan-600"></span>
                <span class="text-slate-600 dark:text-slate-400">Selected</span>
              </span>
              <span class="flex items-center gap-1">
                <span class="w-4 h-4 rounded bg-slate-400 dark:bg-slate-500"></span>
                <span class="text-slate-600 dark:text-slate-400">Occupied</span>
              </span>
            </div>
          </header>

          <div class="bg-gradient-to-b from-cyan-600 to-cyan-700 text-white text-center py-2 rounded-t-xl text-sm font-bold tracking-wider mb-4">
            STAGE
          </div>

          <div class="overflow-x-auto pb-2">
            <div class="flex flex-col items-center gap-2 min-w-fit">
              
              <!-- Filas A a la H -->
              @foreach (var row in new[] { "A", "B", "C", "D", "E", "F", "G", "H" })
              {
                <div class="flex items-center gap-1">
                  <span class="w-6 text-xs font-bold text-slate-400 dark:text-slate-500 text-center" aria-hidden="true">@row</span>
                  <div class="flex gap-1">
                    @for (int i = 1; i <= 12; i++)
                    {
                      var seatId = $"{row}{i}";
                      // Simular asientos ocupados de manera visual
                      var isOccupied = (row == "A" && i == 3) || (row == "B" && i == 5) || (row == "C" && i == 8);

                      if (isOccupied)
                      {
                        <button type="button" disabled class="seat w-8 h-8 sm:w-9 sm:h-9 rounded-t-lg text-xs font-bold bg-slate-400 dark:bg-slate-500 cursor-not-allowed text-white">
                          @i
                        </button>
                      }
                      else
                      {
                        <label class="seat w-8 h-8 sm:w-9 sm:h-9 rounded-t-lg text-xs font-bold bg-slate-200 dark:bg-slate-600 hover:bg-cyan-400 dark:hover:bg-cyan-500 text-slate-600 dark:text-slate-300 flex items-center justify-center cursor-pointer transition-all has-[:checked]:bg-cyan-600 has-[:checked]:text-white">
                          <input type="checkbox" name="seats" value="@seatId" class="sr-only">
                          @i
                        </label>
                      }
                    }
                  </div>
                  <span class="w-6 text-xs font-bold text-slate-400 dark:text-slate-500 text-center" aria-hidden="true">@row</span>
                </div>
              }

            </div>
          </div>
        </article>

      </section>

      <!-- Panel Derecho – Resumen de Compra -->
      <aside class="lg:col-span-2">
        <section class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 sticky top-20">
          <header class="p-4 border-b border-slate-200 dark:border-slate-700">
            <h2 class="text-lg font-bold text-slate-900 dark:text-white">Order Summary</h2>
          </header>

          <div class="p-4 space-y-4">
            <div>
              <label for="customerEmail" class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-2">
                Customer Email *
              </label>
              <input type="email" id="customerEmail" name="customerEmail" required
                     class="w-full h-14 px-4 text-base bg-slate-50 dark:bg-slate-700 border-2 border-slate-200 dark:border-slate-600 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 focus:border-cyan-600 focus:ring-0 outline-none transition-colors"
                     placeholder="customer@email.com">
            </div>

            <fieldset>
              <legend class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-2">Payment Method</legend>
              <div class="grid grid-cols-2 gap-3">
                <label class="btn-touch h-20 flex flex-col items-center justify-center gap-2 border-2 border-slate-200 dark:border-slate-600 rounded-xl text-slate-600 dark:text-slate-300 hover:border-cyan-600 hover:text-cyan-600 cursor-pointer transition-all has-[:checked]:border-cyan-600 has-[:checked]:bg-cyan-50 has-[:checked]:text-cyan-600">
                  <input type="radio" name="paymentMethod" value="CASH" checked required class="sr-only">
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
                  </svg>
                  <span class="font-bold">CASH</span>
                </label>
                <label class="btn-touch h-20 flex flex-col items-center justify-center gap-2 border-2 border-slate-200 dark:border-slate-600 rounded-xl text-slate-600 dark:text-slate-300 hover:border-cyan-600 hover:text-cyan-600 cursor-pointer transition-all has-[:checked]:border-cyan-600 has-[:checked]:bg-cyan-50 has-[:checked]:text-cyan-600">
                  <input type="radio" name="paymentMethod" value="CARD" required class="sr-only">
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                  </svg>
                  <span class="font-bold">CARD</span>
                </label>
              </div>
            </fieldset>

            <div class="pt-4 border-t border-slate-200 dark:border-slate-700 space-y-2">
              <div class="flex justify-between text-sm">
                <span class="text-slate-500 dark:text-slate-400">Total Price</span>
                <span class="text-cyan-600 font-bold">$45.00</span>
              </div>
            </div>

            <button type="submit"
                    class="w-full h-20 bg-cyan-600 hover:bg-cyan-700 active:bg-cyan-800 text-white text-2xl font-bold rounded-2xl shadow-lg transition-all flex items-center justify-center gap-3 mt-4">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
              </svg>
              Checkout &amp; Print
            </button>
          </div>
        </section>
      </aside>

    </div>
  </form>
</div>
