@model IEnumerable<tickets_management.Models.Events>

<div id="pos-app-container" class="flex h-screen w-screen overflow-hidden">

    <!-- SIDEBAR / NAVIGATION -->
    <aside class="h-screen w-64 fixed left-0 top-0 bg-surface-container-low border-r border-outline-variant flex flex-col py-6 z-20">
        <div class="px-6 mb-8">
            <h1 class="text-2xl font-bold text-primary tracking-tight">CinePOS</h1>
            <p class="text-on-surface-variant text-xs font-semibold opacity-70 tracking-wider uppercase mt-1">Terminal 01 - Main Lobby</p>
        </div>

        <nav class="flex-1 space-y-1 px-2">
            <div onclick="showCatalogView()" id="nav-events" class="flex items-center gap-4 px-4 py-3 bg-secondary-container text-on-secondary-container border-r-4 border-primary font-bold transition-all duration-150 cursor-pointer rounded-r-lg">
                <a asp-action="Pos" asp-controller="BoxOffice" class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-high transition-colors group">
                    <span class="material-symbols-outlined">confirmation_number</span>
                    <span class="text-sm">Events</span>
                </a>
            </div>
            <div class="flex items-center gap-4 px-4 py-3 text-on-surface-variant hover:bg-surface-container-high transition-colors cursor-pointer rounded-lg">
                <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-high transition-colors group" asp-controller="BoxOffice" asp-action="Orders">
                    <span class="material-symbols-outlined">receipt_long</span>
                    <span class="text-sm">Orders</span>
                </a>
            </div>
        </nav>

        <div class="px-4 mt-auto pt-6">
            <button onclick="showCatalogView()" class="w-full bg-primary text-on-primary py-3 rounded-lg font-bold flex items-center justify-center gap-2 hover:opacity-90 active:scale-[0.98] transition-all text-sm shadow-md">
                <span class="material-symbols-outlined text-lg">add</span>
                New Transaction
            </button>
            <div class="mt-6 flex items-center gap-3 p-2 rounded-lg hover:bg-surface-container-high cursor-pointer">
                <img alt="Cashier Portrait" class="w-10 h-10 rounded-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB5vrVF1eYC992Gzt6Au88Cr5bX7oVyo4G7F1efRPezzbXqmUYgBEs1injblzmxyKLkV7T8TdhJR3c8aKXyQE5HTY7AszhaTSO0ZZTx6FoNhrcsLXvq89i9hy26YFJ_s8U0dFow2TDdixLXvmt1jltK0-EBGiikvlyjtCFplAXXTRMpO1mS9zgQZu3Zm6u0UGtblj9vf9nrFdeeAndrqGwbd7Yc93KYT2KsbS2g4yVJj1xu-4C-l71fp84NIvUXkQREpI9psm6jQJCs"/>
                <div>
                    <p class="font-bold text-on-surface text-sm leading-none">Alex Rivers</p>
                    <p class="text-on-surface-variant text-[10px] font-semibold uppercase tracking-wider mt-1">CASHIER</p>
                </div>
            </div>
        </div>
    </aside>

    <div class="flex-1 ml-64 flex flex-col h-full overflow-hidden">

        <!-- SECTION 1: EVENT CATALOG -->
        <section id="view-pos-catalog" class="flex flex-col flex-1 h-full overflow-hidden">
            <header class="h-16 bg-surface border-b border-outline-variant flex justify-between items-center px-8 sticky top-0 z-10">
                <div class="flex items-center flex-1 max-w-2xl">
                    <div class="relative w-full">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">search</span>
                        <input class="w-full pl-10 pr-4 py-1.5 bg-surface-container-low border-none rounded-full text-sm focus:ring-2 focus:ring-primary outline-none" placeholder="Search events, movies, or shows..." type="text"/>
                    </div>
                </div>

                <div class="flex items-center gap-6 ml-6">
                    <a asp-action="Logout" asp-controller="BoxOffice" class="flex items-center gap-2 bg-error/10 text-error px-4 py-1.5 rounded-full text-xs font-bold uppercase hover:bg-error/20 transition-all active:scale-[0.98]">
                        <span class="material-symbols-outlined text-lg">logout</span>
                        Logout
                    </a>
                    @if (TempData["OrderSuccess"] != null)
                    {
                        <div id="successModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center">
                            <div class="bg-surface p-xl rounded-2xl shadow-xl max-w-md w-full text-center border border-outline-variant">
                                <span class="material-symbols-outlined text-5xl text-primary mb-md">check_circle</span>
                                <h2 class="font-headline-md text-headline-md text-on-surface font-bold mb-xs">Invoice Generated!</h2>
                                <p class="text-on-surface-variant font-body-md mb-lg">@TempData["OrderSuccess"]</p>
                                <button onclick="document.getElementById('successModal').style.display='none'" class="w-full bg-primary text-on-primary py-md rounded-lg font-bold hover:opacity-90 transition-all">
                                    Continue
                                </button>
                            </div>
                        </div>
                    }
                    @if (TempData["OrderError"] != null)
                    {
                        <div id="errorModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center">
                            <div class="bg-surface p-xl rounded-2xl shadow-xl max-w-md w-full text-center border border-outline-variant">
                                <span class="material-symbols-outlined text-5xl text-error mb-md">error</span>
                                <h2 class="font-headline-md text-headline-md text-on-surface font-bold mb-xs">Warning!</h2>
                                <p class="text-on-surface-variant font-body-md mb-lg">@TempData["OrderError"]</p>
                                <button onclick="document.getElementById('errorModal').style.display='none'" class="w-full bg-error text-on-error py-md rounded-lg font-bold hover:opacity-90 transition-all">
                                    Got it
                                </button>
                            </div>
                        </div>
                    }

                    <div class="h-8 w-px bg-outline-variant"></div>
                    <div class="flex items-center gap-4">
                        <button class="p-1.5 rounded-full hover:bg-secondary-container/50 transition-all relative">
                            <span class="material-symbols-outlined text-on-surface-variant">notifications</span>
                            <span class="absolute top-1 right-1 w-2 h-2 bg-error rounded-full"></span>
                        </button>
                        <button class="p-1.5 rounded-full hover:bg-secondary-container/50 transition-all">
                            <span class="material-symbols-outlined text-on-surface-variant">help_outline</span>
                        </button>
                    </div>
                </div>
            </header>

            <div class="p-8 space-y-6 flex-1 overflow-y-auto">
                <div class="flex justify-between items-end mb-4">
                    <div>
                        <h2 class="text-2xl font-bold text-on-surface">Available Events</h2>
                        <p class="text-sm text-on-surface-variant">Select a show to start selling</p>
                    </div>
                    <div class="flex gap-4">
                        <div class="bg-surface-container-high p-4 rounded-xl flex items-center gap-4 min-w-[160px]">
                            <span class="material-symbols-outlined text-primary text-[32px]">event_seat</span>
                            <div>
                                <p class="text-[10px] font-bold uppercase tracking-wider text-on-surface-variant">Occupancy Today</p>
                                <p class="text-xl font-bold text-primary">84%</p>
                            </div>
                        </div>
                        <div class="bg-surface-container-high p-4 rounded-xl flex items-center gap-4 min-w-[160px]">
                            <span class="material-symbols-outlined text-tertiary text-[32px]">trending_up</span>
                            <div>
                                <p class="text-[10px] font-bold uppercase tracking-wider text-on-surface-variant">Shift Sales</p>
                                <p class="text-xl font-bold text-tertiary">$12,450</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                    @if (Model != null)
                    {
                    foreach (var ev in Model)
                    {
                    <div onclick="showSeatsView('@ev.Name', @ev.Id)" class="group event-card bg-surface-container-lowest border border-outline-variant rounded-xl overflow-hidden hover:shadow-lg hover:border-primary transition-all duration-300 cursor-pointer flex flex-col h-full">
                        <div class="relative aspect-[2/3] overflow-hidden">
                            @if (!string.IsNullOrEmpty(ev.PosterUrl) && ev.PosterUrl.StartsWith("http"))
                            {
                            <img alt="Cinema Poster" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="@ev.PosterUrl"/>
                            }
                            else
                            {
                            <img alt="Cinema Poster" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?q=80&w=400"/>
                            }
                            @if (ev.IsActive)
                            {
                            <div class="absolute top-3 right-3 bg-primary-container text-on-primary-container px-2 py-1 rounded text-[10px] font-bold tracking-wider uppercase">ACTIVE</div>
                            }
                            <div class="event-overlay absolute inset-0 bg-primary/20 opacity-0 transition-opacity duration-300 flex items-center justify-center">
                                <span class="bg-primary text-on-primary px-6 py-2 rounded-full font-bold shadow-lg">Buy Tickets</span>
                            </div>
                        </div>
                        <div class="p-4 space-y-1 flex-1 flex flex-col">
                            <h3 class="text-lg font-bold text-on-surface line-clamp-1">@ev.Name</h3>
                            <div class="flex items-center gap-1.5 text-on-surface-variant text-sm">
                                <span class="material-symbols-outlined text-[18px]">calendar_today</span>
                                <span>@ev.StartDate.ToString("dd MMM yyyy, HH:mm")</span>
                            </div>
                            <div class="flex items-center gap-1.5 text-on-surface-variant text-sm">
                                <span class="material-symbols-outlined text-[18px]">location_on</span>
                                <span>@(string.IsNullOrEmpty(ev.VenueName) ? $"Sala {ev.VenueId}" : ev.VenueName)</span>
                            </div>
                            <div class="pt-3 mt-auto flex justify-between items-center border-t border-outline-variant/30">
                                <span class="text-[10px] font-bold text-on-surface-variant uppercase">From</span>
                                <span class="text-lg font-bold text-primary" id="price-ev-@ev.Id">...</span>
                            </div>
                        </div>
                    </div>
                    }
                    }
                </div>
            </div>
        </section>

        <!-- SECTION 2: SEATS SELECTION (HIDDEN BY DEFAULT) -->
        <section id="view-seats-selection" class="flex flex-1 h-full overflow-hidden hidden">
            <div class="flex-1 overflow-hidden flex flex-col bg-surface-container-lowest">

                <div class="px-8 py-5 bg-surface-container-low border-b border-outline-variant flex justify-between items-start">
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <button onclick="showCatalogView()" class="text-primary flex items-center hover:underline text-sm font-bold">
                                <span class="material-symbols-outlined text-md">arrow_back</span> Back to Billboard
                            </button>
                        </div>
                        <h3 id="selected-movie-title" class="text-2xl font-bold text-on-surface">Hamlet: El Príncipe de Dinamarca</h3>
                        <div class="flex gap-6 mt-1 text-on-surface-variant">
                            <span class="flex items-center gap-1 text-sm">
                                <span class="material-symbols-outlined text-[18px]">calendar_today</span>
                                Viernes, 14 Jun • 19:30
                            </span>
                            <span class="flex items-center gap-1 text-sm">
                                <span class="material-symbols-outlined text-[18px]">location_on</span>
                                Teatro Nacional de San Salvador
                            </span>
                        </div>
                    </div>
                    <div class="flex gap-4">
                        <div class="flex flex-col gap-1">
                            <label class="text-[10px] text-on-surface-variant opacity-70 uppercase font-bold">Category</label>
                            <select id="select-category-filter" onchange="filterSeatsBySelectors()" class="bg-surface-container-lowest border border-outline-variant rounded-lg px-3 py-1.5 text-sm min-w-[140px] outline-none">
                                <option value="Todas">All</option>
                                <option value="Platea Baja">Lower Stalls</option>
                                <option value="Platea Media">Middle Stalls</option>
                                <option value="Platea Alta">Upper Stalls</option>
                            </select>
                        </div>
                        <div class="flex flex-col gap-1">
                            <label class="text-[10px] text-on-surface-variant opacity-70 uppercase font-bold">Section</label>
                            <select id="select-section-filter" onchange="filterSeatsBySelectors()" class="bg-surface-container-lowest border border-outline-variant rounded-lg px-3 py-1.5 text-sm min-w-[140px] outline-none">
                                <option value="Todas">All rows</option>
                                <option value="Platea Baja">Lower Stalls (A-C)</option>
                                <option value="Platea Media">Middle Stalls (D-G)</option>
                                <option value="Platea Alta">Upper Stalls (H-J)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="flex-1 overflow-auto p-8 flex flex-col items-center">
                    <div class="w-full max-w-5xl">
                        <div class="w-full h-10 bg-secondary rounded-b-3xl flex items-center justify-center mb-8 shadow-md relative overflow-hidden">
                            <span class="text-on-primary text-xs font-semibold tracking-[0.3em] uppercase">Escenario / Stage</span>
                            <div class="absolute inset-0 bg-gradient-to-b from-white/10 to-transparent"></div>
                        </div>

                        <div class="flex justify-center gap-6 mb-8 border-b border-outline-variant pb-4 text-xs">
                            <div class="flex items-center gap-2">
                                <div class="w-4 h-4 rounded bg-surface-container border border-outline-variant"></div>
                                <span>AVAILABLE</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <div class="w-4 h-4 rounded bg-primary"></div>
                                <span>SELECTED</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <div class="w-4 h-4 rounded bg-error flex items-center justify-center text-[10px] text-on-error font-bold">X</div>
                                <span class="text-error font-bold">SOLD</span>
                            </div>
                            <div class="h-4 w-[1px] bg-outline-variant mx-2"></div>
                            <div class="flex items-center gap-2">
                                <div class="w-4 h-4 rounded bg-tertiary"></div>
                                <span id="legend-vip-price">LOWER</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <div class="w-4 h-4 rounded bg-primary-container"></div>
                                <span id="legend-general-price">MIDDLE</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <div class="w-4 h-4 rounded bg-secondary-container"></div>
                                <span id="legend-alta-price">UPPER</span>
                            </div>
                        </div>

                        <div class="flex flex-col gap-2 items-center py-6 bg-surface-container-low/30 rounded-xl border border-dashed border-outline-variant">
                            <p id="current-grid-section-label" class="text-xs font-bold text-on-surface-variant mb-6 uppercase tracking-widest">Full Stalls</p>
                            <div id="dynamic-grid-placeholder" class="flex flex-col gap-1.5">
                                <!-- Dynamic map injected here -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ORDER SUMMARY SIDEBAR -->
            <aside class="w-96 bg-surface border-l border-outline-variant flex flex-col p-6 shadow-[-10px_0_30px_-15px_rgba(0,0,0,0.05)] z-10">
                <div class="mb-6">
                    <h4 class="text-lg font-bold text-on-surface mb-3">Order Summary</h4>
                    <div class="bg-surface-container-high/50 rounded-lg p-4 border border-outline-variant">
                        <p class="font-bold text-primary text-sm">Session Details</p>
                        <p id="summary-movie-title" class="text-sm text-on-surface-variant">Hamlet: El Príncipe de Dinamarca</p>
                        <p class="text-xs font-semibold text-on-surface-variant/70 mt-1">Lower Stalls • 14 Jun 19:30</p>
                    </div>
                </div>

                <div class="flex-1 overflow-y-auto pr-1">
                    <div class="flex items-center justify-between mb-4">
                        <h4 id="ticket-count-label" class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Selected Tickets (0)</h4>
                        <button onclick="clearCart()" class="text-primary font-bold text-xs hover:underline">Clear</button>
                    </div>

                    <div id="selected-tickets-container" class="space-y-3">
                        <!-- Dynamic ticket list rows injected here -->
                    </div>
                </div>

                <div class="mt-6 pt-6 border-t border-outline-variant border-dashed">
                    <div class="space-y-2 mb-6 text-sm">
                        <div class="flex justify-between items-center text-on-surface-variant">
                            <span>Subtotal</span>
                            <span id="summary-subtotal" class="font-mono">$0</span>
                        </div>
                        <div class="flex justify-between items-center text-on-surface-variant">
                            <span>Service Charge</span>
                            <span id="summary-service-charge" class="font-mono">$0</span>
                        </div>
                        <div class="flex justify-between items-center pt-3 border-t border-outline-variant/30">
                            <span class="text-lg font-bold">Total</span>
                            <span id="summary-total" class="text-lg font-bold text-primary">$0</span>
                        </div>
                    </div>
                    <form asp-action="PersistOrder" asp-controller="BoxOffice" method="post">
                        <input type="hidden" name="OrderData" id="order-data-input" />
                        <button type="submit" onclick="prepareAndSubmit(event)" class="w-full bg-primary text-on-primary h-14 rounded-lg font-bold flex items-center justify-center gap-2 hover:brightness-110 active:scale-[0.98] transition-all shadow-xl shadow-primary/20">
                            Proceed to Payment
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </button>
                    </form>
                </div>
            </aside>
        </section>

    </div>
</div>

<script>
    // --- Configuración Global de Precios por Zona ---
    // Cargados desde la BD al abrir cada evento, no hardcodeados
    let PRICING_RULES = {
        'PLATEA BAJA':  { price: 0, label: 'PLATEA BAJA',  icon: 'stars',      css: 'tertiary' },
        'PLATEA MEDIA': { price: 0, label: 'PLATEA MEDIA', icon: 'chair',      css: 'primary' },
        'PLATEA ALTA':  { price: 0, label: 'PLATEA ALTA',  icon: 'event_seat', css: 'secondary' }
    };
    const SERVICE_CHARGE_RATE = 0.07;

    const rowsArr    = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J'];
    const gridTarget = document.getElementById('dynamic-grid-placeholder');

    let currentOrder = {
        movie:   '',
        eventId: 0,
        seats:   []
    };

    // --- Carga asientos ocupados + precios reales desde el servidor ---
    async function loadSeatData(eventId) {
        const response = await fetch(`/BoxOffice/GetSeatData?eventId=${eventId}`);
        const data     = await response.json();

        // Actualizar precios reales desde TicketTypes de db_catalog
        data.ticketTypes.forEach(tt => {
            const key = tt.name.toUpperCase();
            if (key.includes('BAJA')) {
                PRICING_RULES['PLATEA BAJA'].price = parseFloat(tt.price);
            } else if (key.includes('MEDIA')) {
                PRICING_RULES['PLATEA MEDIA'].price = parseFloat(tt.price);
            } else if (key.includes('ALTA')) {
                PRICING_RULES['PLATEA ALTA'].price = parseFloat(tt.price);
            }
        });

        // Actualizar leyenda con precios reales
        document.getElementById('legend-vip-price').textContent     = `BAJA ($${PRICING_RULES['PLATEA BAJA'].price.toFixed(2)})`;
        document.getElementById('legend-general-price').textContent = `MEDIA ($${PRICING_RULES['PLATEA MEDIA'].price.toFixed(2)})`;
        document.getElementById('legend-alta-price').textContent = `ALTA ($${PRICING_RULES['PLATEA ALTA'].price.toFixed(2)})`;

        // Ocupados = vendidos en db_sales + en proceso de compra ahora (Singleton)
        return [...data.occupiedSeats, ...data.pendingSeats];
    }

    // --- Inicialización del mapa con asientos reales ---
    async function initSeatMap(occupiedSeats = []) {
        const occupiedSet = new Set(occupiedSeats);

        gridTarget.innerHTML = rowsArr.map(row => {
            let zone = 'PLATEA BAJA';
            if (['D', 'E', 'F', 'G'].includes(row)) zone = 'PLATEA MEDIA';
            else if (['H', 'I', 'J'].includes(row)) zone = 'PLATEA ALTA';

            return `
                <div data-row-letter="${row}" class="seat-row-container flex items-center gap-4 transition-all duration-200">
                    <span class="w-6 text-right font-mono text-xs text-on-surface-variant/60">${row}</span>
                    <div class="seat-grid flex gap-1">
                        ${Array(20).fill(0).map((_, i) => {
                const seatNum = i + 1;
                const seatId  = `${row}-${seatNum}`;

                if (occupiedSet.has(seatId)) {
                    return `<button disabled class="w-6 h-6 rounded-sm bg-error text-on-error text-[10px] font-mono cursor-not-allowed flex items-center justify-center pointer-events-none" title="Vendido">X</button>`;
                }

                const zoneClasses = zone === 'PLATEA BAJA'
                    ? 'bg-surface-container text-tertiary border border-tertiary/20 hover:ring-2 hover:ring-tertiary/50'
                    : zone === 'PLATEA MEDIA'
                    ? 'bg-surface-container text-primary border border-primary/20 hover:ring-2 hover:ring-primary/50'
                    : 'bg-surface-container text-secondary border border-secondary/20 hover:ring-2 hover:ring-secondary/50';

                return `
                                <button
                                    data-id="${seatId}"
                                    data-row="${row}"
                                    data-num="${seatNum}"
                                    data-zone="${zone}"
                                    onclick="toggleSeatSelection(this)"
                                    class="seat-btn w-6 h-6 rounded-sm transition-all flex items-center justify-center font-mono text-[10px] ${zoneClasses}">
                                    ${seatNum}
                                </button>
                            `;
            }).join('')}
                    </div>
                    <span class="w-6 text-left font-mono text-xs text-on-surface-variant/60">${row}</span>
                </div>
            `;
        }).join('');
    }

    // --- Lógica de Interacción con las Sillas ---
    function toggleSeatSelection(btn) {
        const id    = btn.dataset.id;
        const row   = btn.dataset.row;
        const num   = parseInt(btn.dataset.num);
        const zone  = btn.dataset.zone;
        const price = PRICING_RULES[zone].price;

        const index = currentOrder.seats.findIndex(s => s.id === id);

        if (index > -1) {
            currentOrder.seats.splice(index, 1);
            applySeatStyle(btn, zone, false);
        } else {
            currentOrder.seats.push({ id, row, num, zone, price });
            applySeatStyle(btn, zone, true);
        }

        updateOrderSummary();
    }

    function applySeatStyle(btn, zone, isSelected) {
        if (isSelected) {
            btn.classList.remove('bg-surface-container', 'text-tertiary', 'text-primary', 'text-secondary');
            if(zone === 'PLATEA BAJA') {
                btn.classList.add('bg-tertiary', 'text-white', 'ring-2', 'ring-tertiary', 'scale-110');
            } else if(zone === 'PLATEA MEDIA') {
                btn.classList.add('bg-primary', 'text-white', 'ring-2', 'ring-primary', 'scale-110');
            } else {
                btn.classList.add('bg-secondary', 'text-white', 'ring-2', 'ring-secondary', 'scale-110');
            }
        } else {
            btn.classList.remove('bg-tertiary', 'bg-primary', 'bg-secondary', 'text-white', 'ring-2', 'ring-tertiary', 'ring-primary', 'ring-secondary', 'scale-110');
            if (zone === 'PLATEA BAJA') {
                btn.classList.add('bg-surface-container', 'text-tertiary');
            } else if (zone === 'PLATEA MEDIA') {
                btn.classList.add('bg-surface-container', 'text-primary');
            } else {
                btn.classList.add('bg-surface-container', 'text-secondary');
            }
        }
    }

    function removeSeatById(id) {
        currentOrder.seats = currentOrder.seats.filter(s => s.id !== id);
        const btn = document.querySelector(`[data-id="${id}"]`);
        if (btn) applySeatStyle(btn, btn.dataset.zone, false);
        updateOrderSummary();
    }

    function clearCart() {
        currentOrder.seats.forEach(seat => {
            const btn = document.querySelector(`[data-id="${seat.id}"]`);
            if (btn) applySeatStyle(btn, seat.zone, false);
        });
        currentOrder.seats = [];
        updateOrderSummary();
    }

    // --- Actualización Dinámica del Resumen ---
    function updateOrderSummary() {
        document.getElementById('ticket-count-label').textContent = `Selected Tickets (${currentOrder.seats.length})`;

        const container = document.getElementById('selected-tickets-container');
        const copFormatter = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 });

        if (currentOrder.seats.length === 0) {
            container.innerHTML = `<p class="text-xs text-on-surface-variant/60 text-center py-6 italic">No seats selected for this session.</p>`;
        } else {
            container.innerHTML = currentOrder.seats.map(seat => {
                const rules = PRICING_RULES[seat.zone];
                return `
                    <div class="p-4 rounded-lg bg-surface-container-lowest border border-outline-variant flex items-center justify-between group hover:border-primary transition-colors">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-lg ${rules.css === 'tertiary' ? 'bg-tertiary/10 text-tertiary' : rules.css === 'primary' ? 'bg-primary/10 text-primary' : 'bg-secondary/10 text-secondary'} flex items-center justify-center">
                                <span class="material-symbols-outlined">${rules.icon}</span>
                            </div>
                            <div>
                                <p class="font-bold text-on-surface text-sm">Seat ${seat.id}</p>
                                <p class="text-[10px] font-bold ${rules.css === 'tertiary' ? 'text-tertiary' : rules.css === 'primary' ? 'text-primary' : 'text-secondary'} uppercase">${rules.label}</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="font-mono font-bold text-sm">${copFormatter.format(seat.price)}</p>
                            <button onclick="removeSeatById('${seat.id}')" class="text-error opacity-0 group-hover:opacity-100 transition-opacity">
                                <span class="material-symbols-outlined text-md">delete</span>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        const subtotal      = currentOrder.seats.reduce((sum, s) => sum + s.price, 0);
        const serviceCharge = subtotal * SERVICE_CHARGE_RATE;
        const total         = subtotal + serviceCharge;

        document.getElementById('summary-subtotal').textContent       = copFormatter.format(subtotal);
        document.getElementById('summary-service-charge').textContent = copFormatter.format(serviceCharge);
        document.getElementById('summary-total').textContent          = copFormatter.format(total);
    }

    // --- Continuar al pago ---
    function prepareAndSubmit(event) {
        if (currentOrder.seats.length === 0) {
            event.preventDefault();
            alert('Por favor, selecciona al menos un asiento antes de continuar.');
            return;
        }
        document.getElementById('order-data-input').value = JSON.stringify(currentOrder);
    }

    // --- Abrir vista de asientos para un evento ---
    async function showSeatsView(movieName, eventId) {
        document.getElementById('view-pos-catalog').classList.add('hidden');
        document.getElementById('view-seats-selection').classList.remove('hidden');
        document.getElementById('selected-movie-title').innerText = movieName;
        document.getElementById('summary-movie-title').innerText  = movieName;

        currentOrder.movie   = movieName;
        currentOrder.eventId = eventId;
        currentOrder.seats   = [];

        // Mostrar loading mientras carga la BD
        gridTarget.innerHTML = `<p class="text-center text-on-surface-variant py-8 animate-pulse">Cargando mapa de asientos...</p>`;

        const occupiedSeats = await loadSeatData(eventId);
        await initSeatMap(occupiedSeats);

        updateOrderSummary();

        document.getElementById('nav-events').className = "flex items-center gap-4 px-4 py-3 bg-secondary-container text-on-secondary-container border-r-4 border-primary font-bold transition-all duration-150 cursor-pointer rounded-r-lg";
    }

    function showCatalogView() {
        document.getElementById('view-seats-selection').classList.add('hidden');
        document.getElementById('view-pos-catalog').classList.remove('hidden');
    }

    function filterSeatsBySelectors() {
        const category = document.getElementById('select-category-filter').value;
        const section  = document.getElementById('select-section-filter').value;
        const rows     = document.querySelectorAll('.seat-row-container');

        rows.forEach(rowView => {
            const rowLetter = rowView.dataset.rowLetter;
            const isBaja  = ['A', 'B', 'C'].includes(rowLetter);
            const isMedia = ['D', 'E', 'F', 'G'].includes(rowLetter);
            const isAlta  = ['H', 'I', 'J'].includes(rowLetter);

            let matchesCategory = true;
            let matchesSection  = true;

            if (category === 'Platea Baja' && !isBaja) matchesCategory = false;
            if (category === 'Platea Media' && !isMedia) matchesCategory = false;
            if (category === 'Platea Alta' && !isAlta) matchesCategory = false;

            if (section === 'Platea Baja' && !isBaja) matchesSection = false;
            if (section === 'Platea Media' && !isMedia) matchesSection = false;
            if (section === 'Platea Alta' && !isAlta) matchesSection = false;

            rowView.classList.toggle('hidden', !(matchesCategory && matchesSection));
        });
    }

    window.addEventListener('DOMContentLoaded', () => {
        updateOrderSummary();
    });
</script>