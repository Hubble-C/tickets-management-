@{
    Layout = null;
    var orderNumber = ViewData["OrderNumber"]?.ToString();
    var eventName = ViewData["EventName"]?.ToString();
    var date = ViewData["Date"]?.ToString();
    var venue = ViewData["Venue"]?.ToString();
    var hourAt = ViewData["HourAt"]?.ToString();
    var ticketsStr = ViewData["Tickets"]?.ToString(); // "Code1|Seat1,Code2|Seat2"
    
    var tickets = new List<(string Code, string Seat)>();
    if (!string.IsNullOrEmpty(ticketsStr))
    {
        foreach (var t in ticketsStr.Split(','))
        {
            var parts = t.Split('|');
            if (parts.Length == 2)
            {
                tickets.Add((parts[0], parts[1]));
            }
        }
    }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Tickets — Orden #@orderNumber</title>
    <style>
        :root { --ticket-width: 48mm; }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        html, body {
            width: var(--ticket-width);
            font-family: "Segoe UI", Arial, sans-serif;
            color: #000;
            background: #fff;
        }

        .ticket {
            width: var(--ticket-width);
            padding: 2mm 1.5mm 4mm;
            text-align: center;
            page-break-after: always;
        }
        .ticket:last-child { page-break-after: auto; }

        .brand {
            font-size: 15pt;
            font-weight: 800;
            letter-spacing: 1px;
            line-height: 1.05;
            text-transform: uppercase;
        }
        .subtitle {
            font-size: 6.5pt;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-top: 0.5mm;
        }
        .stars {
            font-size: 9pt;
            letter-spacing: 2px;
            margin: 0.5mm 0;
        }

        .admit {
            display: inline-block;
            font-size: 9pt;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            border: 1px solid #000;
            padding: 0.5mm 3mm;
            margin: 1mm 0;
        }

        .qr { margin: 1.5mm auto 0.5mm; width: 36mm; height: 36mm; }
        .qr img { width: 100% !important; height: 100% !important; display: block; image-rendering: pixelated; }

        .code {
            font-family: "Consolas", "Courier New", monospace;
            font-size: 9.5pt;
            font-weight: 700;
            letter-spacing: 1px;
            word-break: break-all;
        }

        .meta {
            font-size: 8pt;
            line-height: 1.35;
            text-align: left;
            margin: 1mm 0;
        }
        .meta .row { display: flex; justify-content: space-between; gap: 2mm; }
        .meta .label { font-weight: 700; text-transform: uppercase; font-size: 7pt; letter-spacing: 0.5px; }
        .meta .val { text-align: right; }

        .rule { border: none; border-top: 1.5px solid #000; margin: 1.5mm 0; }
        .dashed { border: none; border-top: 1px dashed #000; margin: 1.5mm 0; }

        .footer {
            font-size: 7pt;
            margin-top: 1.5mm;
            line-height: 1.3;
        }

        @@media screen {
            body { margin: 16px auto; box-shadow: 0 0 0 1px #ddd; }
            .print-bar { text-align: center; margin: 12px 0; }
            .print-bar button {
                font: 14px/1 "Segoe UI", Arial, sans-serif;
                padding: 8px 16px; cursor: pointer;
            }
            .print-bar .volver-btn {
                background: #0891b2;
                color: #fff;
                border: none;
                border-radius: 6px;
                margin-left: 10px;
            }
        }
        @@media print {
            .print-bar { display: none !important; }
            @@page { size: 58mm auto; margin: 0; }
        }
    </style>
</head>
<body>
    <div class="print-bar">
        <button type="button" onclick="window.print()">Print Tickets</button>
        <button type="button" class="volver-btn" onclick="window.location.href='/BoxOffice/Pos'">Back to POS</button>
    </div>

    @foreach (var t in tickets)
    {
        <div class="ticket">
            <div class="brand">Teatro Central</div>
            <div class="subtitle">Admission Ticket</div>
            <div class="stars">★ ★ ★ ★ ★</div>

            <hr class="rule" />
            <div class="admit">Admit One</div>
            <hr class="dashed" />

            @{
                var ticketDtos = ViewData["TicketDtos"] as List<tickets_management.Models.ViewModels.BoughtTicketDto>;
                var dto = ticketDtos?.FirstOrDefault(d => d.TicketCode == t.Code);
                var qrData = t.Code;
                if (dto != null) {
                    var dict = new {
                        user = dto.UserId,
                        seat = dto.Seat,
                        date = dto.EventDate.ToString("yyyy-MM-dd"),
                        event_id = dto.EventId,
                        venue_id = dto.VenueId,
                        status = dto.Status.ToString()
                    };
                    qrData = System.Text.Json.JsonSerializer.Serialize(dict);
                }
            }
            <div class="qr"><img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=@System.Net.WebUtility.UrlEncode(qrData)" alt="@t.Code" /></div>
            <div class="code">@t.Code</div>

            <hr class="dashed" />
            <div class="meta">
                <div class="row"><span class="label">Event</span><span class="val">@eventName</span></div>
                <div class="row"><span class="label">Date</span><span class="val">@date</span></div>
                <div class="row"><span class="label">Time</span><span class="val">@hourAt</span></div>
                @if (!string.IsNullOrWhiteSpace(venue))
                {
                    <div class="row"><span class="label">Venue</span><span class="val">@venue</span></div>
                }
                <div class="row"><span class="label">Seat</span><span class="val">@t.Seat</span></div>
                <div class="row"><span class="label">Order</span><span class="val">#@orderNumber</span></div>
            </div>

            <hr class="rule" />
            <div class="footer">
                Present this code at the entrance.<br />
                Valid only if the order is paid.
            </div>
        </div>
    }

    <script>
        window.addEventListener("load", function () { window.print(); });
    </script>
</body>
</html>
