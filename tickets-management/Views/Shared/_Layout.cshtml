<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Theater POS</title>
    <!-- CDN de Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&amp;family=JetBrains+Mono:wght@500&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "on-surface-variant": "#3e484d",
                    "on-tertiary-container": "#fffbff",
                    "on-secondary": "#ffffff",
                    "outline": "#6e797e",
                    "on-primary-fixed": "#001f28",
                    "surface-tint": "#006780",
                    "primary-container": "#007f9d",
                    "on-tertiary": "#ffffff",
                    "on-surface": "#0b1c30",
                    "inverse-surface": "#213145",
                    "on-tertiary-fixed-variant": "#2f2ebe",
                    "inverse-primary": "#6cd3f7",
                    "primary-fixed": "#b7eaff",
                    "tertiary-fixed-dim": "#c0c1ff",
                    "outline-variant": "#bdc8ce",
                    "secondary-container": "#d4e6e7",
                    "surface": "#f8f9ff",
                    "on-primary-fixed-variant": "#004e61",
                    "secondary-fixed": "#d4e6e7",
                    "on-tertiary-fixed": "#07006c",
                    "primary-fixed-dim": "#6cd3f7",
                    "surface-bright": "#f8f9ff",
                    "on-error": "#ffffff",
                    "surface-variant": "#d3e4fe",
                    "secondary": "#516162",
                    "on-primary-container": "#fafdff",
                    "error": "#ba1a1a",
                    "background": "#f8f9ff",
                    "on-background": "#0b1c30",
                    "surface-container-low": "#eff4ff",
                    "primary": "#00647c",
                    "surface-container-lowest": "#ffffff",
                    "on-secondary-container": "#576769",
                    "tertiary": "#4648d4",
                    "inverse-on-surface": "#eaf1ff",
                    "surface-container": "#e5eeff",
                    "secondary-fixed-dim": "#b8cacb",
                    "on-secondary-fixed": "#0e1e1f",
                    "tertiary-fixed": "#e1e0ff",
                    "tertiary-container": "#6063ee",
                    "surface-dim": "#cbdbf5",
                    "surface-container-highest": "#d3e4fe",
                    "on-primary": "#ffffff",
                    "on-error-container": "#93000a",
                    "on-secondary-fixed-variant": "#394a4b",
                    "error-container": "#ffdad6",
                    "surface-container-high": "#dce9ff"
            },
            "borderRadius": {
                    "DEFAULT": "0.25rem",
                    "lg": "0.5rem",
                    "xl": "0.75rem",
                    "full": "9999px"
            },
            "spacing": {
                    "xl": "32px",
                    "sm": "8px",
                    "md": "16px",
                    "xs": "4px",
                    "lg": "24px",
                    "edge_margin": "16px",
                    "base": "4px",
                    "gutter": "12px"
            },
            "fontFamily": {
                    "headline-lg": ["Hanken Grotesk"],
                    "label-caps": ["Hanken Grotesk"],
                    "headline-md": ["Hanken Grotesk"],
                    "data-mono": ["JetBrains Mono"],
                    "body-md": ["Hanken Grotesk"],
                    "body-lg": ["Hanken Grotesk"]
            },
            "fontSize": {
                    "headline-lg": ["24px", {"lineHeight": "32px", "fontWeight": "700"}],
                    "label-caps": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "700"}],
                    "headline-md": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                    "data-mono": ["13px", {"lineHeight": "16px", "fontWeight": "500"}],
                    "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                    "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}]
            }
          },
        },
      }
    </script>
    <style>
      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      }
      body {
        font-family: 'Hanken Grotesk', sans-serif;
        background-color: #f8f9ff;
      }
      .custom-scroll::-webkit-scrollbar {
        width: 6px;
      }
      .custom-scroll::-webkit-scrollbar-track {
        background: transparent;
      }
      .custom-scroll::-webkit-scrollbar-thumb {
        background: #bdc8ce;
        border-radius: 10px;
      }
      .event-card:hover .event-overlay {
        opacity: 1;
      }

      .material-symbols-outlined {
          font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      }
      ::-webkit-scrollbar {
          width: 6px;
      }
      ::-webkit-scrollbar-track {
          background: transparent;
      }
      ::-webkit-scrollbar-thumb {
          background: #bdc8ce;
          border-radius: 10px;
      }
      .seat-grid {
          display: grid;
          grid-template-columns: repeat(20, minmax(0, 1fr));
          gap: 4px;
      }
      .stage-curve {
          clip-path: ellipse(60% 100% at 50% 0%);
      }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-900 min-h-screen text-slate-800 dark:text-slate-100 flex flex-col transition-colors duration-300">
    <div class="flex-1">
        @RenderBody()
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>