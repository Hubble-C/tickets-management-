<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Theater POS</title>
    <!-- CDN de Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#ecfeff',
                            100: '#cffafe',
                            200: '#a5f3fc',
                            300: '#67e8f9',
                            400: '#22d3ee',
                            500: '#06b6d4',
                            600: '#0891b2',
                            700: '#0e7490',
                            800: '#155e75',
                            900: '#164e63',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        * { touch-action: manipulation; }
        .seat { transition: all 0.15s ease; }
        .seat:active { transform: scale(0.92); }
        .btn-touch { min-height: 56px; }
        .btn-touch:active { transform: scale(0.97); }
        @@keyframes pulse-glow {
            0%, 100% { box-shadow: 0 0 0 0 rgba(8, 145, 178, 0.4); }
            50% { box-shadow: 0 0 0 12px rgba(8, 145, 178, 0); }
        }
        .checkout-pulse { animation: pulse-glow 2s infinite; }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-900 min-h-screen text-slate-800 dark:text-slate-100 flex flex-col transition-colors duration-300">
    <div class="flex-1">
        @RenderBody()
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>